// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url      = env("DATABASE_URL")
}

enum TeamRole {
  OWNER
  ADMIN
  ORGANIZER
  MEMBER
}

enum TeamStatus {
  REGULAR
  VERIFIED
  HIDDEN
  BLOCKED
}

enum TeamJoinRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED_BY_USER
}

enum TeamInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED_BY_TEAM
}

enum NotificationType {
  EVENT_APPLICATION_ACCEPTED
  EVENT_APPLICATION_REJECTED
  EVENT_APPLICATION_RECEIVED
  POST_COMMENTED
  POST_LIKED
  TEAM_JOIN_REQUEST_ACCEPTED
  TEAM_JOIN_REQUEST_REJECTED
  TEAM_JOIN_REQUEST_RECEIVED
  TEAM_INVITATION_RECEIVED
  TEAM_INVITATION_ACCEPTED
  TEAM_INVITATION_REJECTED
  REPORT_RESOLVED
  REPORT_DISMISSED
  EVENT_STATUS_CHANGED
  FOLLOWED_TEAM_EVENT_CREATED
  FOLLOWED_OBJECT_EVENT_CREATED
  FOLLOWED_TEAM_POST_CREATED
  FOLLOWED_OBJECT_POST_CREATED
}

enum TeamFunctionRole {
  OPERATOR
  PHOTOGRAPHER
  MEDIC
  INSTRUCTOR
  COORDINATOR
  RADIO_OPERATOR
}

enum ObjectType {
  BRIDGE
  BUILDING
  TOWER
  CLIFF
  INDUSTRIAL
  OTHER
}

enum ObjectVisibility {
  PUBLIC
  HIDDEN
}

enum EventStatus {
  DRAFT
  PUBLISHED
  APPLICATIONS_OPEN
  FULL
  APPLICATIONS_CLOSED
  POSTPONED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED_BY_USER
  CONFIRMED_PARTICIPATION
  NO_SHOW
}

enum BadgeCategory {
  PARTICIPATION
  OBJECTS
  HEIGHT
  EVENT
  ROLE
  CONTENT
  SPECIAL
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PENDING
  UPLOADED
  FAILED
  DELETED
}

enum ReportStatus {
  OPEN
  REVIEWED
  RESOLVED
  DISMISSED
}

enum PostPinTargetType {
  TEAM
  EVENT
  OBJECT
}

enum AuditAction {
  TEAM_CREATED
  TEAM_UPDATED
  TEAM_VERIFIED
  TEAM_MEMBER_ADDED
  TEAM_MEMBER_REMOVED
  TEAM_MEMBER_ROLE_UPDATED
  TEAM_MEMBER_FUNCTION_ROLES_UPDATED
  TEAM_OWNER_TRANSFERRED
  TEAM_MEMBER_LEFT
  TEAM_JOIN_REQUEST_ACCEPTED
  TEAM_JOIN_REQUEST_REJECTED
  TEAM_INVITATION_CREATED
  TEAM_INVITATION_CANCELLED
  TEAM_INVITATION_ACCEPTED
  TEAM_INVITATION_REJECTED
  EVENT_CREATED
  EVENT_UPDATED
  EVENT_COMPLETED
  APPLICATION_ACCEPTED
  APPLICATION_REJECTED
  PARTICIPATION_CONFIRMED
  OBJECT_CREATED
  OBJECT_HIDDEN
  BADGE_GRANTED
  CONTENT_HIDDEN
  USER_BLOCKED
}

// Necessary for Next auth
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? // @db.Text
  access_token             String? // @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? // @db.Text
  session_state            String?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh_token_expires_in Int?

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                      String               @id @default(cuid())
  name                    String?
  email                   String?              @unique
  emailVerified           DateTime?
  image                   String?
  accounts                Account[]
  sessions                Session[]
  profile                 Profile?
  teamMemberships         TeamMember[]
  createdObjects          JumpObject[]         @relation("CreatedObjects")
  createdEvents           Event[]              @relation("CreatedEvents")
  eventApplications       EventApplication[]   @relation("EventApplications")
  decidedApplications     EventApplication[]   @relation("DecidedApplications")
  eventParticipations     EventParticipation[] @relation("EventParticipations")
  confirmedParticipations EventParticipation[] @relation("ConfirmedParticipations")
  media                   Media[]              @relation("UserMedia")
  badges                  UserBadge[]          @relation("UserBadges")
  awardedBadges           UserBadge[]          @relation("AwardedBadges")
  posts                   Post[]               @relation("PostAuthor")
  comments                Comment[]            @relation("CommentAuthor")
  postLikes               PostLike[]           @relation("PostLikes")
  postViews               PostView[]
  reports                 Report[]             @relation("ReportsFiled")
  reviewedReports         Report[]             @relation("ReportsReviewed")
  auditLogs               AuditLog[]           @relation("AuditLogActor")
  teamJoinRequests        TeamJoinRequest[]    @relation("TeamJoinRequests")
  decidedTeamJoinRequests TeamJoinRequest[]    @relation("TeamJoinRequestDecisions")
  teamInvitationsReceived TeamInvitation[]     @relation("TeamInvitationsReceived")
  teamInvitationsSent     TeamInvitation[]     @relation("TeamInvitationsSent")
  notifications           Notification[]       @relation("UserNotifications")
  createdPostPins         PostPin[]            @relation("PostPinsCreated")
  teamFollows             TeamFollow[]
  objectFollows           ObjectFollow[]
  objectLikes             ObjectLike[]
  objectImpressions       ObjectImpression[]
  eventChatMessages       EventChatMessage[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Profile {
  id                          String   @id @default(cuid())
  userId                      String   @unique
  username                    String?  @unique
  displayName                 String?
  bio                         String?
  city                        String?
  avatarUrl                   String?
  avatarMediaId               String?
  externalExperience          String?
  selfReportedJumpCount       Int?
  selfReportedMaxHeightMeters Int?
  selfReportedExperience      String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarMedia Media? @relation("ProfileAvatarMedia", fields: [avatarMediaId], references: [id], onDelete: SetNull)

  @@index([avatarMediaId])
}

model Team {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  region      String?
  logoUrl     String?
  logoMediaId String?
  status      TeamStatus @default(REGULAR)
  verifiedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  members      TeamMember[]
  events       Event[]
  logoMedia    Media?            @relation("TeamLogoMedia", fields: [logoMediaId], references: [id], onDelete: SetNull)
  objects      JumpObject[]      @relation("TeamObjects")
  posts        Post[]
  joinRequests TeamJoinRequest[]
  invitations  TeamInvitation[]
  followers    TeamFollow[]

  @@index([status])
  @@index([region])
  @@index([logoMediaId])
}

model TeamFollow {
  id        String   @id @default(cuid())
  userId    String
  teamId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([userId])
  @@index([teamId])
  @@index([createdAt])
}

model TeamMember {
  id                   String             @id @default(cuid())
  teamId               String
  userId               String
  role                 TeamRole           @default(MEMBER)
  functionRoles        TeamFunctionRole[] @default([])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  eventCrewMemberships EventCrewMember[]

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
}

model TeamJoinRequest {
  id          String                @id @default(cuid())
  teamId      String
  userId      String
  status      TeamJoinRequestStatus @default(PENDING)
  message     String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  team      Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User  @relation("TeamJoinRequests", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("TeamJoinRequestDecisions", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([userId])
  @@index([teamId, status])
  @@index([userId, status])
  @@index([decidedById])
}

model TeamInvitation {
  id            String               @id @default(cuid())
  teamId        String
  invitedUserId String
  invitedById   String?
  role          TeamRole             @default(MEMBER)
  functionRoles TeamFunctionRole[]   @default([])
  status        TeamInvitationStatus @default(PENDING)
  message       String?
  decidedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  team        Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedUser User  @relation("TeamInvitationsReceived", fields: [invitedUserId], references: [id], onDelete: Cascade)
  invitedBy   User? @relation("TeamInvitationsSent", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([invitedUserId])
  @@index([invitedById])
  @@index([teamId, status])
  @@index([invitedUserId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, readAt])
  @@index([createdAt])
}

model JumpObject {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  type            ObjectType
  visibility      ObjectVisibility @default(PUBLIC)
  heightMeters    Int?
  region          String?
  description     String?
  coverImageUrl   String?
  coverMediaId    String?
  createdById     String?
  createdByTeamId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  createdBy     User?                @relation("CreatedObjects", fields: [createdById], references: [id], onDelete: SetNull)
  createdByTeam Team?                @relation("TeamObjects", fields: [createdByTeamId], references: [id], onDelete: SetNull)
  coverMedia    Media?               @relation("ObjectCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  events        Event[]
  galleryImages ObjectGalleryImage[]
  posts         Post[]
  followers     ObjectFollow[]
  likes         ObjectLike[]
  impressions   ObjectImpression[]

  @@index([visibility])
  @@index([type])
  @@index([region])
  @@index([createdById])
  @@index([createdByTeamId])
  @@index([coverMediaId])
}

model ObjectFollow {
  id        String   @id @default(cuid())
  userId    String
  objectId  String
  createdAt DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  object JumpObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([userId, objectId])
  @@index([userId])
  @@index([objectId])
  @@index([createdAt])
}

model ObjectLike {
  id        String   @id @default(cuid())
  userId    String
  objectId  String
  createdAt DateTime @default(now())

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  object JumpObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([userId, objectId])
  @@index([userId])
  @@index([objectId])
  @@index([createdAt])
}

model ObjectImpression {
  id        String    @id @default(cuid())
  objectId  String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?
  hiddenAt  DateTime?

  object JumpObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([objectId, authorId])
  @@index([objectId])
  @@index([authorId])
  @@index([createdAt])
  @@index([hiddenAt])
}

model Event {
  id               String      @id @default(cuid())
  teamId           String
  objectId         String?
  createdById      String
  title            String
  slug             String      @unique
  description      String?
  requirementsText String?
  region           String?
  startsAt         DateTime
  endsAt           DateTime?
  status           EventStatus @default(DRAFT)
  capacity         Int?
  priceText        String?
  levelText        String?
  coverImageUrl    String?
  coverMediaId     String?
  completedAt      DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  team           Team                 @relation(fields: [teamId], references: [id])
  object         JumpObject?          @relation(fields: [objectId], references: [id], onDelete: SetNull)
  createdBy      User                 @relation("CreatedEvents", fields: [createdById], references: [id])
  coverMedia     Media?               @relation("EventCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  applications   EventApplication[]
  participations EventParticipation[]
  crewMembers    EventCrewMember[]
  galleryImages  EventGalleryImage[]
  posts          Post[]
  chatMessages   EventChatMessage[]

  @@index([status])
  @@index([startsAt])
  @@index([teamId])
  @@index([objectId])
  @@index([createdById])
  @@index([coverMediaId])
}

model EventApplication {
  id            String            @id @default(cuid())
  eventId       String
  userId        String
  status        ApplicationStatus @default(PENDING)
  message       String?
  organizerNote String?
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User  @relation("EventApplications", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("DecidedApplications", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([eventId, status])
  @@index([userId])
  @@index([status])
  @@index([decidedById])
}

model EventParticipation {
  id            String   @id @default(cuid())
  eventId       String
  userId        String
  confirmedById String?
  confirmedAt   DateTime @default(now())
  createdAt     DateTime @default(now())

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User  @relation("EventParticipations", fields: [userId], references: [id], onDelete: Cascade)
  confirmedBy User? @relation("ConfirmedParticipations", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([confirmedById])
}

model EventChatMessage {
  id              String    @id @default(cuid())
  eventId         String
  authorId        String
  parentMessageId String?
  body            String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  editedAt        DateTime?
  deletedAt       DateTime?
  hiddenAt        DateTime?

  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author        User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentMessage EventChatMessage?   @relation("EventChatReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies       EventChatMessage[]  @relation("EventChatReplies")

  @@index([eventId])
  @@index([authorId])
  @@index([parentMessageId])
  @@index([createdAt])
  @@index([deletedAt])
  @@index([hiddenAt])
}

model EventCrewMember {
  id            String             @id @default(cuid())
  eventId       String
  teamMemberId  String
  functionRoles TeamFunctionRole[] @default([])
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  teamMember TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)

  @@unique([eventId, teamMemberId])
  @@index([eventId])
  @@index([teamMemberId])
}

model EventGalleryImage {
  id        String   @id @default(cuid())
  eventId   String
  mediaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  media Media @relation("EventGalleryMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([eventId, mediaId])
  @@index([eventId])
  @@index([mediaId])
  @@index([eventId, sortOrder])
}

model ObjectGalleryImage {
  id        String   @id @default(cuid())
  objectId  String
  mediaId   String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  object JumpObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  media  Media      @relation("ObjectGalleryMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([objectId, mediaId])
  @@index([objectId])
  @@index([mediaId])
  @@index([objectId, sortOrder])
}

model Badge {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  category    BadgeCategory
  iconUrl     String?
  isManual    Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  userBadges UserBadge[]
}

model UserBadge {
  id          String   @id @default(cuid())
  userId      String
  badgeId     String
  awardedById String?
  awardedAt   DateTime @default(now())
  reason      String?

  user      User  @relation("UserBadges", fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedBy User? @relation("AwardedBadges", fields: [awardedById], references: [id], onDelete: SetNull)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([awardedById])
}

model Post {
  id           String    @id @default(cuid())
  authorId     String
  teamId       String?
  eventId      String?
  objectId     String?
  content      String
  imageUrl     String?
  imageMediaId String?
  hiddenAt     DateTime?
  viewsCount   Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  author     User        @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  team       Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  event      Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  imageMedia Media?      @relation("PostImageMedia", fields: [imageMediaId], references: [id], onDelete: SetNull)
  object     JumpObject? @relation(fields: [objectId], references: [id], onDelete: SetNull)
  comments   Comment[]
  likes      PostLike[]
  views      PostView[]
  pins       PostPin[]

  @@index([authorId])
  @@index([teamId])
  @@index([eventId])
  @@index([objectId])
  @@index([createdAt])
  @@index([hiddenAt])
  @@index([imageMediaId])
}

model PostView {
  id              String   @id @default(cuid())
  postId          String
  userId          String?
  anonymousIdHash String?
  createdAt       DateTime @default(now())
  lastSeenAt      DateTime @updatedAt

  post Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@unique([postId, anonymousIdHash])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  content   String
  hiddenAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
  @@index([createdAt])
  @@index([hiddenAt])
}

model PostLike {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation("PostLikes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model PostPin {
  id         String            @id @default(cuid())
  postId     String
  targetType PostPinTargetType
  targetId   String
  pinnedById String?
  createdAt  DateTime          @default(now())

  post     Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  pinnedBy User? @relation("PostPinsCreated", fields: [pinnedById], references: [id], onDelete: SetNull)

  @@unique([postId, targetType, targetId])
  @@index([postId])
  @@index([targetType, targetId])
  @@index([pinnedById])
  @@index([createdAt])
}

model Media {
  id         String      @id @default(cuid())
  ownerId    String
  type       MediaType
  status     MediaStatus @default(PENDING)
  bucket     String
  key        String
  url        String?
  mimeType   String?
  sizeBytes  Int?
  width      Int?
  height     Int?
  alt        String?
  uploadedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime    @default(now())

  owner               User                 @relation("UserMedia", fields: [ownerId], references: [id], onDelete: Cascade)
  profileAvatars      Profile[]            @relation("ProfileAvatarMedia")
  teamLogos           Team[]               @relation("TeamLogoMedia")
  eventCovers         Event[]              @relation("EventCoverMedia")
  eventGalleryImages  EventGalleryImage[]  @relation("EventGalleryMedia")
  objectCovers        JumpObject[]         @relation("ObjectCoverMedia")
  objectGalleryImages ObjectGalleryImage[] @relation("ObjectGalleryMedia")
  postImages          Post[]               @relation("PostImageMedia")

  @@unique([bucket, key])
  @@index([ownerId])
  @@index([status])
  @@index([ownerId, status])
  @@index([deletedAt])
  @@index([type])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  targetType   String
  targetId     String
  reason       String
  details      String?
  status       ReportStatus @default(OPEN)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reporter   User  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ReportsReviewed", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reviewedById])
  @@index([status])
  @@index([targetType, targetId])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  action     AuditAction
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}
